# Copie este arquivo para ".env" antes de rodar o projeto:
#   cp .env.example .env
#
# Se você conectou um banco Postgres na Vercel (Storage → Postgres) e rodou
# `vercel env pull .env`, esse comando já baixa DATABASE_URL e
# DATABASE_URL_UNPOOLED certinhas — não precisa preencher à mão.

# Conexão pooled — usada pela aplicação em runtime.
DATABASE_URL="postgresql://usuario:senha@host:5432/banco"
# Conexão direta (sem pooler) — usada pelo Prisma CLI para migrations.
DATABASE_URL_UNPOOLED="postgresql://usuario:senha@host:5432/banco"

# URL pública da aplicação (usada em metadata, OG, JSON-LD e no webhook do
# Mercado Pago). Em produção, use a URL real do site.
APP_URL="http://localhost:3000"

# Token de acesso do Mercado Pago (Checkout Pro). Só necessário se o fluxo
# de reserva/pagamento online em /reservas for reativado.
# https://www.mercadopago.com.br/developers/panel/app
MERCADOPAGO_ACCESS_TOKEN=""

# Segredo usado para assinar o cookie de sessão do painel administrativo.
# Gere um valor aleatório forte, ex: openssl rand -hex 32
AUTH_SECRET="dev-only-insecure-secret-change-me"
